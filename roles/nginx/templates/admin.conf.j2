server {
    listen      80;
    server_name admin.{{ main_domain_name }};
    return      301 https://$host$request_uri;
}

server {
    listen      443 ssl;
    server_name admin.{{ main_domain_name }};
    root        {{ www_path }};
    include     /etc/nginx/default.d/*.conf;
    include     /etc/nginx/conf.d/admin.conf-*;
}
