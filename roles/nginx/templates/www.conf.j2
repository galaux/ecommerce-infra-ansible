# Main
server {
    listen      443 ssl default_server;
    server_name www.{{ main_domain_name }};
    # modsecurity on;
    # modsecurity_rules_file /etc/nginx/main.conf;
    root        /var/www/prestashop;
    access_log  /var/log/nginx/www-access.log main;
    error_log   /var/log/nginx/www-error.log;
    include     /etc/nginx/default.d/*.conf;
    include     /etc/nginx/conf.d/www.conf-*;
}

# Main redirections
server {
    listen      80;
    server_name www.{{ main_domain_name }} {{ main_domain_name }};
    access_log  /var/log/nginx/www-access.log main;
    error_log   /var/log/nginx/www-error.log;
    return      301 https://www.{{ main_domain_name }}$request_uri;
}

server {
    listen      443 ssl;
    server_name {{ main_domain_name }};
    access_log  /var/log/nginx/www-access.log main;
    error_log   /var/log/nginx/www-error.log;
    include     /etc/nginx/default.d/*.conf;
    return      301 https://www.{{ main_domain_name }}$request_uri;
}
{% for alt_hosted_zone in alt_hosted_zones %}

# {{ alt_hosted_zone.domain_name }} redirections
server {
    listen      80;
    listen      443 ssl;
    server_name www.{{ alt_hosted_zone.domain_name }} {{ alt_hosted_zone.domain_name }};
    access_log  /var/log/nginx/www-access.log main;
    error_log   /var/log/nginx/www-error.log;
    include     /etc/nginx/default.d/*.conf;
    return      301 https://www.{{ main_domain_name }}{{ alt_hosted_zone.ps_path_prefix }}$request_uri;
}
{% endfor %}
