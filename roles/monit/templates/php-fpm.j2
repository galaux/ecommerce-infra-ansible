check process php-fpm with pidfile {{ php_fpm_pid_path }}
  start program = "/bin/systemctl start php-fpm" with timeout 60 seconds
  stop program  = "/bin/systemctl stop php-fpm"
  if cpu > 60% for 2 cycles then alert
  if cpu > 80% for 5 cycles then restart
  if totalmem > 1500.0 MB for 5 cycles then restart
  if children > 250 then restart
  if loadavg(5min) greater than 10 for 8 cycles then stop
  if 3 restarts within 5 cycles then timeout

