#!/bin/bash

PS_DIR={{ prestashop_path }}
BACKUP_TIME=$(date +%F-%H%M%S)

TO_BACKUP=('classes'
           'download'
           'img'
           'mails'
           'modules'
           'themes/simple-great'
           'themes/example'
           'translations'
           'upload')

echo "New backup: ${BACKUP_TIME}"

TEMP_DIR=$(mktemp -d)

for d in ${TO_BACKUP[@]}; do
  tar -czf \
    ${TEMP_DIR}/${d/\//_}.tgz \
    -C ${PS_DIR} \
    ${d}
done

tar -czf \
  ${TEMP_DIR}/cert-{{ fqdn }}.tgz \
  -C /etc \
  letsencrypt

cp ${PS_DIR}/robots.txt \
  ${TEMP_DIR}

mysqldump \
  {{ mysql_ps_db_name }} \
  | bzip2 \
  > ${TEMP_DIR}/db_ps.sql.bz2


aws s3 cp \
  ${TEMP_DIR}/cert-{{ fqdn }}.tgz \
  s3://prestashop-data/

rm ${TEMP_DIR}/cert-{{ fqdn }}.tgz

aws s3 sync \
  ${TEMP_DIR}/ \
  s3://prestashop-data/${BACKUP_TIME}/

rm -rf ${TEMP_DIR}
