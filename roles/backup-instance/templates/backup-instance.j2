#!/bin/bash

PS_DIR={{ prestashop_path }}
BACKUP_TIME=$(date +%F-%H%M%S)

TO_BACKUP=('classes'
           'download'
           'img'
           'mails'
           'modules'
           'themes/simple-great'
           'themes/example'
           'translations'
           'upload')

echo "New backup: ${BACKUP_TIME}"

TEMP_DIR=$(mktemp -d)

# Main files
for d in ${TO_BACKUP[@]}; do
  tar -czf \
    ${TEMP_DIR}/${d/\//_}.tgz \
    -C ${PS_DIR} \
    ${d}
done

cp ${PS_DIR}/robots.txt \
  ${TEMP_DIR}

grep '_PS_VERSION_' '/var/www/prestashop/config/settings.inc.php' \
  | sed -E "s/define[(]'_PS_VERSION_', '(.*)'[)];/\1/" \
  > ${TEMP_DIR}/{{ prestashop_version_file_name }}

mysqldump \
  {{ mysql_ps_db_name }} \
  | bzip2 \
  > ${TEMP_DIR}/db_ps.sql.bz2

aws s3 sync \
  ${TEMP_DIR}/ \
  s3://{{ prestashop_backup_bucket }}/${BACKUP_TIME}/


# Certificates
tar -czf \
  ${TEMP_DIR}/cert-{{ fqdn }}.tgz \
  -C /etc \
  letsencrypt

aws s3 cp \
  ${TEMP_DIR}/cert-{{ fqdn }}.tgz \
  s3://{{ prestashop_backup_bucket }}/


# "latest" backup version file
echo ${BACKUP_TIME} > ${TEMP_DIR}/latest
aws s3 cp \
  ${TEMP_DIR}/latest \
  s3://{{ prestashop_backup_bucket }}/latest


rm -rf ${TEMP_DIR}
