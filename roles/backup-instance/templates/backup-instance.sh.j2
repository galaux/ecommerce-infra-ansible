#!/bin/sh

if [ -n "$(ls -A {{ backup_data_snippet_dir }})" ];
then
  BACKUP_TIME=$(date +%F-%H%M%S)
  echo "New backup: ${BACKUP_TIME}"

  TEMP_DIR=$(mktemp -d)
  mkdir ${TEMP_DIR}/${BACKUP_TIME}

  for snippet in {{ backup_data_snippet_dir }}/*;
  do
    ${snippet} "${TEMP_DIR}/${BACKUP_TIME}" "${TEMP_DIR}"
  done

  aws s3 sync \
    ${TEMP_DIR}/ \
    s3://{{ prestashop_backup_bucket }}/
  {% if is_prod %}

  aws s3 rm --recursive \
    s3://{{ prestashop_backup_bucket }}/{{ backup_date_latest_label }}

  aws s3 sync \
    s3://{{ prestashop_backup_bucket }}/${BACKUP_TIME}/ \
    s3://{{ prestashop_backup_bucket }}/{{ backup_date_latest_label }}
  {% endif %}

  rm -rf ${TEMP_DIR}
fi
