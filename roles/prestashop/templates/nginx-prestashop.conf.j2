server {
    listen 443 ssl default_server;
    server_name  {{ fqdn }} www.{{ fqdn }};
    root {{ prestashop_path }};

    ssl_certificate /etc/letsencrypt/live/www.{{ fqdn }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.{{ fqdn }}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Load configuration files for the default server block.
    include /etc/nginx/default.d/*.conf;

    location / {
        rewrite ^/api/?(.*)$ /webservice/dispatcher.php?url=$1 last;
        rewrite ^/([0-9])(-[_a-zA-Z0-9-]*)?(-[0-9]+)?/.+\.jpg$ /img/p/$1/$1$2.jpg last;
        rewrite ^/([0-9])([0-9])(-[_a-zA-Z0-9-]*)?(-[0-9]+)?/.+\.jpg$ /img/p/$1/$2/$1$XXXXXXXX last;
        rewrite ^/([0-9])([0-9])([0-9])(-[_a-zA-Z0-9-]*)?(-[0-9]+)?/.+\.jpg$ /img/p/$1/$2/$3/$1$XXXXXXXX last;
        rewrite ^/([0-9])([0-9])([0-9])([0-9])(-[_a-zA-Z0-9-]*)?(-[0-9]+)?/.+\.jpg$ /img/p/$1/$2/$3/$4/$1$XXXXXXXX last;
        rewrite ^/([0-9])([0-9])([0-9])([0-9])([0-9])(-[_a-zA-Z0-9-]*)?(-[0-9]+)?/.+\.jpg$ /img/p/$1/$2/$3/$4/$5/$1$XXXXXXXX last;
        rewrite ^/([0-9])([0-9])([0-9])([0-9])([0-9])([0-9])(-[_a-zA-Z0-9-]*)?(-[0-9]+)?/.+\.jpg$ /img/p/$1/$2/$3/$4/$5/$6/$1$XXXXXXXX last;
        rewrite ^/([0-9])([0-9])([0-9])([0-9])([0-9])([0-9])([0-9])(-[_a-zA-Z0-9-]*)?(-[0-9]+)?/.+\.jpg$ /img/p/$1/$2/$3/$4/$5/$6/$7/$1$XXXXXXXX last;
        rewrite ^/([0-9])([0-9])([0-9])([0-9])([0-9])([0-9])([0-9])([0-9])(-[_a-zA-Z0-9-]*)?(-[0-9]+)?/.+\.jpg$ /img/p/$1/$2/$3/$4/$5/$6/$7/$8/$1$XXXXXXXX last;
        rewrite ^/c/([0-9]+)(-[_a-zA-Z0-9-]*)(-[0-9]+)?/.+\.jpg$ /img/c/$1$2.jpg last;
        rewrite ^/c/([a-zA-Z-]+)(-[0-9]+)?/.+\.jpg$ /img/c/$1.jpg last;
        rewrite ^/([0-9]+)(-[_a-zA-Z0-9-]*)(-[0-9]+)?/.+\.jpg$ /img/c/$1$2.jpg last;
        try_files $uri $uri/ /index.php?$args;
    }

    #location = /favicon.ico {
    #    log_not_found off;      # PrestaShop by default does not provide a favicon.ico
    #    access_log off;         # Disable logging to prevent excessive log sizes
    #}

    location = /robots.txt {
        auth_basic off;        # Whatever happens, always let bots know about your policy
        allow all;
        log_not_found off;     # Prevent excessive log size
        access_log off;
    }

    location ~* \.(?:ico|css|js|gif|jpe?g|png)$ {
        expires 30d;
        add_header Pragma public;
        add_header Cache-Control "public";
    }

    gzip  on;
    gzip_vary on;
    #gzip_min_length 1000;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types
        text/plain
        text/css
        text/js
        text/xml
        text/javascript
        application/javascript
        application/x-javascript
        application/json
        application/xml
        application/rss+xml
        image/svg+xml;
    gzip_disable "msie6";

    #gzip on;
    #gzip_disable "msie6";
    ## Also compress content with other MIME types than "text/html"
    #gzip_vary on;
    ## We only want to compress json, css and js. Compressing images and such isn't worth it
    #gzip_types application/json text/css application/javascript;
    #gzip_proxied any;
    ## Set desired compression ratio, higher is better compression, but slower
    #gzip_comp_level 6;
    ## Gzip buffer size
    #gzip_buffers 16 8k;
    ## Compress every type of HTTP request
    #gzip_http_version 1.0;

}
