LoadPlugin curl_json
<Plugin curl_json>
<URL "http://127.0.0.1{{ php_fpm_status_path }}?json">
 Instance 'main'
 <Key "accepted conn">
     Type "phpfpm_requests"
     Instance ""
 </Key>
 <Key "slow requests">
     Type "phpfpm_slow_requests"
     Instance ""
 </Key>
 <Key "listen queue">
     Type "phpfpm_listen_queue"
     Instance ""
 </Key>
 <Key "active processes">
     Type "phpfpm_processes"
     Instance "active"
 </Key>
 <Key "total processes">
     Type "phpfpm_processes"
     Instance "total"
 </Key>
</URL>
</Plugin>

LoadPlugin processes
<Plugin "processes">
  ProcessMatch "php-fpm" "php-fpm"
</Plugin>
