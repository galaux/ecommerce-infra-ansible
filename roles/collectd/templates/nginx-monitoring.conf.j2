server {
    listen 443 ssl;
    server_name  admin.{{ fqdn }};
    root {{ www_path }};

    ssl_certificate /etc/letsencrypt/live/admin.{{fqdn}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.{{fqdn}}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Load configuration files for the default server block.
    include /etc/nginx/default.d/*.conf;

    location /monitoring {
        auth_basic           "closed site";
        auth_basic_user_file /etc/nginx/htpasswd;

        gzip on;
        gzip_types "application/javascript text/css";
        # The static files do not change often, cache hint 1 month
        expires 1M;
    }
}
