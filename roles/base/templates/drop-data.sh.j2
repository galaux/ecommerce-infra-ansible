#!/bin/sh

echo "You are going to wipe this instance's data. Please type 'CONTINUE' to proceed."
read answer
if [ "x$answer" != 'xCONTINUE' ];
then
  echo "Nothing done."
  exit 1
fi

echo "Removing data:"

echo "- stopping nginx"
systemctl stop nginx

# Prestashop
echo "- removing Prestashop files"
rm -rf {{ prestashop_path }}
echo "- dropping Prestashop database"
mysql --execute "DROP DATABASE IF EXISTS {{ mysql_ps_db_name }}"

# Wordpress
echo "- removing Wordpress files"
rm -rf {{ wordpress_path }}
echo "- dropping Wordpress database"
mysql --execute "DROP DATABASE IF EXISTS {{ mysql_wp_db_name }}"

# Collectd
echo "- Stopping Collectd"
systemctl stop collectd
echo "- removing Collectd metrics"
rm -rf {{ collectd_path }}
